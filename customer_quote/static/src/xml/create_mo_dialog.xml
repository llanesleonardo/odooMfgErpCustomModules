<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="customer_quote.CreateMODialog">
        <Dialog title="'Create Manufacturing Order'">
            <div class="p-3">
                <p>Are you sure you want to create a Manufacturing Order for this quote?</p>
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button class="btn btn-secondary" t-on-click="props.close">Cancel</button>
                    <button class="btn btn-primary" t-on-click="createMO">Create MO</button>
                </div>
            </div>
        </Dialog>
    </t>
</templates>