<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="mrp_production_form_view_extended" model="ir.ui.view">
            <field name="name">mrp.production.form.view.extended</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view" /> <!-- Full reference to mrp
            module -->
            <field name="arch" type="xml">
                <xpath expr="//field[@name='move_raw_ids']//list" position="inside">
                    <field name="po_id"  />
                    <field name="vendor_id" />                 
            <button name="action_create_po"
                        type="object"
                        string="Create PO"
                        class="btn btn-primary oe_edit_only custom_margin_button"
                        style="margin-top:10px; margin-right:15px; margin-bottom:10px; margin-left:15px;"
                    />
                
                </xpath>
            </field>
        </record>




        <template id="custom_css_inclusion2" inherit_id="web.layout">
            <xpath expr="." position="inside">
                <style>
                    .custom_margin_button {
                    margin: 10px 15px;
                    padding: 10px 25px !important;
                    }
                </style>
            </xpath>
        </template>

    </data>
</odoo>