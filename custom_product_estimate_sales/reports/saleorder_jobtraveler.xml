<odoo>
    <data>
        <template id="report_custom_saleorder2">
            <t t-call="web.html_container">
                <div style="margin-top: 0px;">
                    <t t-set="data_report_margin_top" t-value="10" />
                    <t t-foreach="docs" t-as="o">
                        <div class="page">
                            <!-- Report Title -->
                            <table
                                style=''>
                                <tr>
                                    <!-- Report Title -->
                                    <td
                                        style='width:350px; margin:0 auto; text-align:center; padding: 10px 10px 10px 10px;'>
                                        <img
                                            src="https://sctwebsitestorage.blob.core.windows.net/sctwebsite/images/favico.png"
                                            alt='Logo'
                                            style='margin:0 auto; padding-bottom:10px; max-width:200px; text-align:center' />
                                    </td>
                                    <td
                                        style='width:250px; max-width:500px; margin:0 auto; text-align:center; padding: 0px 10px 0px 10px;'>
                                        <h3
                                            style="text-align: center; font-size: 18px; margin-bottom: 5px;">
                                            Special carbide Tools Inc.
                                        </h3>
                                        <p style='margin:0'>Special carbide Tools Inc.</p>
                                        <p style='margin:0'>3153 E. 36th St. Tucson, AZ 85713 USA.</p>
                                        <p style='margin:0'>Phone: 520-624-0007</p>
                                        <p style='margin:0'>Fax: 520-624-1952</p>
                                    </td>
                                    <td
                                        style='width:250px; max-width:500px; margin:0 auto; text-align:center; padding: 0px 10px 0px 10px;'>
                                        Job Number: 000000
                                    </td>
                                </tr>
                            </table>
                            <h1
                                style="text-align: center; font-size: 24px; margin-bottom: 10px;">
                                Job Traveler
                            </h1>
                            <t t-set="prodquantity" t-value="1" />
                            <div>
                                <t t-if="len(docs) == 1">
                                    <t t-set="doc" t-value="docs[0]" />
                                    <div class="page">
                                        <t t-foreach="o.order_line" t-as="orderline">
                                            <table class="table table-bordered"
                                                style="width:100%; border:1px solid black; background-color:lightgray">

                                                <tr>
                                                    <td style="width: 300px;">
                                                        <p style="font-weight:bold;">Part number: <span
                                                                t-field="doc.name" /></p>
                                                        <p style="font-weight:bold;">Description:</p>
                                                        <p style="font-weight:bold;">Customer: <t
                                                                t-esc="o.partner_id.name" /></p>
                                                        <p style="font-weight:bold;">Qty to make: <span
                                                                t-field="orderline.product_uom_qty" /></p>
                                                    </td>
                                                    <td style="width: 300px;">
                                                        <p style="font-weight:bold;">Revision:</p>
                                                        <p style="font-weight:bold;">Rev Date:<span
                                                                t-field="doc.create_date" /></p>
                                                        <p style="font-weight:bold;">PO Num: </p>
                                                        <p style="font-weight:bold;">Qty Posted: 0 </p>
                                                    </td>
                                                </tr>
                                            </table>
                                        </t>
                                        <div>
                                            <p>
                                                <span
                                                    t-field="doc.note" />
                                            </p>
                                        </div>

                                    </div>
                                </t>
                            </div>
                            <h2
                                style='text-align:center;font-weight:bold;border-bottom:1px solid lightgray;'>
                                Job Notes</h2>
                            <br />
                            <h2 style='text-align:center;font-weight:bold;'>Delivery Schedule</h2>
                            <table
                                class="table "
                                style="width:100%;border-top:1px solid lightgray; ">
                                <thead>
                                    <tr style='border-bottom:0px solid black'>
                                        <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold ; text-align:left">
                                            Order Quantity</th>
                                        <!-- <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold ;
                                        text-align:left">
                                            Release Type
                                        </th>-->
                                        <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold ; text-align:left">
                                            Release Quantity
                                        </th>
                                        <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold; text-align:left">
                                            Due Date
                                        </th>

                                        <!--  <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold;
                                        text-align:left">
                                            Ship Date</th>-->
                                        <!-- <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold;
                                        text-align:left">
                                            Packing List</th>-->
                                        <!-- <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold;
                                        text-align:left">
                                            MFG Job No</th>-->
                                        <!-- <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold;
                                        text-align:left">
                                            Destination Job No</th>-->
                                        <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold; text-align:left">
                                            Comments</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="counter" t-value="1" />
                                    <t t-foreach="o.order_line" t-as="line">
                                        <div>
                                            <tr style=''>
                                                <td
                                                    style="border-bottom: 0px solid black; text-align: left; ">
                                                    <t t-set='prodquantity'
                                                        t-value='line.product_uom_qty' />
                                                    <span
                                                        t-field="line.product_uom_qty" />
                                                </td>
                                                <!--  <td
                                                    style="border-bottom: 0px solid black; text-align: left; ">

                                                    <span />
                                                </td> -->
                                                <td
                                                    style="border-bottom: 0px solid black; text-align: left; ">

                                                    <span
                                                        t-field="line.product_uom_qty" />
                                                </td>
                                                <td
                                                    style="border-bottom: 0px solid black; text-align: left; ">

                                                    <span
                                                        t-field="line.order_due_date" />
                                                </td>
                                                <td>
                                                    Comments
                                                </td>

                                            </tr>
                                            <!-- Add <hr /> outside of the <tr> but inside the
                                            <tbody> -->


                                        </div>
                                    </t>
                                </tbody>
                            </table>

                            <h2 style='text-align:center;font-weight:bold;'>Routing</h2>
                            <br />
                            <t t-if="len(docs) == 1">
                                <t t-set="doc" t-value="docs[0]" />
                                <table
                                    class="table "
                                    style="width:100%;border-top:1px solid lightgray;  ">
                                    <tbody>

                                        <div>
                                            <tr style=''>
                                                <td
                                                    style="border-bottom: 0px solid black; text-align: left; font-weight:bold; ">
                                                    Routed By: <span
                                                        t-field="doc.user_id" />
                                                </td>

                                                <td
                                                    style="border-bottom: 0px solid black; text-align: right;font-weight:bold;  ">
                                                    <t t-set="counter" t-value="1" />
                                                    <t t-foreach="o.order_line" t-as="line"> Run
                                                        Quantity: <span
                                                            t-field="line.product_uom_qty" />
                                                    </t>
                                                </td>
                                            </tr>
                                            <!-- Add <hr /> outside of the <tr> but inside the
                                            <tbody> -->


                                        </div>

                                    </tbody>
                                </table>
                            </t>
                            <br />
                            <t t-set="total_setup_time"
                                t-value="0" />
                            <t t-set='total_setup_time_hours_piece' t-value="0" />
                            <table
                                class="table table-bordered"
                                style="width:100%;  border-collapse: collapse;">
                                <thead>
                                    <tr style='border-bottom:0px solid black'>
                                        <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold ; text-align:left">
                                            Step No</th>
                                        <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold ; text-align:left">
                                            Description
                                        </th>
                                        <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold ; text-align:left">
                                            Setup Time
                                        </th>
                                        <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold; text-align:left">
                                            Cycle Time
                                        </th>

                                        <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold; text-align:left">
                                            Total Time</th>
                                        <!--  <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold;
                                        text-align:left">
                                            Pieces Per Hour</th>-->
                                        <!--   <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold;
                                        text-align:left">
                                            Start</th>-->
                                        <!--   <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold;
                                        text-align:left">
                                            End</th>-->
                                        <!--   <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold;
                                        text-align:left">
                                            Run Quantity</th>-->
                                    </tr>
                                </thead>
                                <tbody style='border-bottom:1px solid lightgray;'>
                                    <t t-set="counter" t-value="1" />

                                    <t
                                        t-foreach="o.order_line.product_id.product_tmpl_id.estimate_ids.work_center_ids"
                                        t-as="workcenter">
                                        <div>

                                            <t t-set="total_time"
                                                t-value="workcenter.setup_time + workcenter.cycle_time" />
                                            <t t-set="total_setup_time"
                                                t-value="total_setup_time + workcenter.setup_time" />
                                            <tr style=''>
                                                <td>

                                                </td>
                                                <td>
                                                    <span t-field='workcenter.display_name' />

                                                </td>
                                                <td
                                                    style="border-bottom: 0px solid black; text-align: left; ">
                                                    <span t-field='workcenter.setup_time' />
                                                    <span t-field='workcenter.setup_unit' />
                                                </td>
                                                <td
                                                    style="border-bottom: 0px solid black; text-align: left; ">
                                                    <span t-field='workcenter.cycle_time' />
                                                    <span t-field='workcenter.setup_unit' />
                                                </td>
                                                <td
                                                    style="border-bottom: 0px solid black; text-align: left; ">
                                                    <span t-esc="total_time/60"
                                                        t-options='{"widget": "float", "precision": 2}' />
                                                </td>
                                                <td>
                                                </td>
                                                <td>
                                                </td>
                                                <td>
                                                </td>
                                                <td>
                                                </td>
                                            </tr>

                                        </div>
                                    </t>
                                    <t t-set='total_setup_time_hours_piece'
                                        value='total_setup_time/60' />
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td></td>
                                        <td colspan="1">
                                            <strong>Time per Piece (HR):</strong>
                                        </td>
                                        <td>

                                            <t t-esc="total_setup_time_hours_piece" />

                                        </td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                        <td colspan="1">
                                            <strong>Total Time for Job (HR):</strong>
                                        </td>
                                        <td>

                                            <t t-set='total_setup_time_hours_job'
                                                value='total_setup_time/60' />
                                            <t t-esc="total_setup_time_hours_job" />
                                        </td>

                                    </tr>
                                </tfoot>
                            </table>
                            <h2
                                style='text-align:center;font-weight:bold; border-bottom:1px solid lightgray'>Material
                                List</h2>
                            <t t-if="len(docs) == 1">
                                <t t-set="doc" t-value="docs[0]" />
                                <div>
                                    <div
                                        style="width:100%;border-bottom: 0px solid black; text-align: right;font-weight:bold; padding-right:20px; ">
                                        <t t-set="counter" t-value="1" />
                                        <t t-foreach="o.order_line" t-as="line"> Quantity: <span
                                                t-field="line.product_uom_qty" />
                                        </t>
                                    </div>
                                </div>
                            </t>
                            <br />
                            <table
                                class="table table-bordered"
                                style="width:100%;  border-collapse: collapse;">

                                <thead>
                                    <tr style='border-bottom:0px solid black'>
                                        <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold ; text-align:left">
                                            Needed</th>
                                        <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold ; text-align:left">
                                            On Hand
                                        </th>
                                        <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold ; text-align:left">
                                            Posted
                                        </th>
                                        <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold; text-align:left">
                                            Short
                                        </th>

                                        <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold; text-align:left">
                                            Unit</th>
                                        <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold; text-align:left">
                                            Part Number</th>
                                        <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold; text-align:left">
                                            Sub-Assy</th>
                                        <th
                                            style="border-bottom: 0px solid black; text-decoration:underline; font-weight:bold; text-align:left">
                                            Vendor</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="counter" t-value="1" />
                                    <t t-set="total_setup_time"
                                        t-value="0" />
                                    <t
                                        t-foreach="o.order_line.product_id.product_tmpl_id.estimate_ids.estimate_material_line_ids"
                                        t-as="materials">
                                        <div>

                                            <t t-set="total_time"
                                                t-value="workcenter.setup_time + workcenter.cycle_time" />
                                            <t t-set="total_setup_time"
                                                t-value="total_setup_time + workcenter.setup_time" />
                                            <tr style=''>
                                                <td>
                                                    <span t-field='materials.quantity' />
                                                </td>
                                                <td>
                                                    0

                                                </td>
                                                <td
                                                    style="border-bottom: 0px solid black; text-align: left; ">
                                                    <span t-field='materials.quantity' />
                                                </td>
                                                <td
                                                    style="border-bottom: 0px solid black; text-align: left; ">
                                                    0
                                                </td>
                                                <td
                                                    style="border-bottom: 0px solid black; text-align: left;padding-top:10px;padding-bottom:10px ">
                                                    <span t-field='materials.unit' />
                                                </td>
                                                <td
                                                    style="border-bottom: 0px solid black; text-align: left; padding-top:10px;padding-bottom:10px">
                                                    <span t-field='materials.product_id' />
                                                </td>
                                                <td
                                                    style="border-bottom: 0px solid black; text-align: left;padding-top:10px;padding-bottom:10px ">
                                                    NO
                                                </td>
                                                <td
                                                    style="border-bottom: 0px solid black; text-align: left;padding-top:10px;padding-bottom:10px ">
                                                    <span t-field='materials.vendor_id' />
                                                </td>
                                            </tr>
                                        </div>
                                    </t>
                                </tbody>
                            </table>
                            <br />
                            <!-- Footer -->
                            <div class="footer"
                                style="position: fixed;
                                    padding: 5px;
                                    bottom: 0;
                                    width: 100%;
                                    height: 50px;
                                    background: rgb(55, 61, 55);
                                    color: white;
                ">
                                <p style="margin: 0;">Thank you for choosing Special Carbide Tools
                                    Inc.</p>
                                <p style="margin: 0;">www.specialcarbide.com | Phone: 520-624-0007|
                                    Fax:
                                    520-624-1952</p>
                            </div>
                        </div>
                    </t>
                </div>

            </t>
        </template>


        <record
            id="action_report_custom_saleorder2" model="ir.actions.report">
            <field name="name">Job Traveler Report</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_product_estimate_sales.report_custom_saleorder2</field>
            <field name="report_file">custom_product_estimate_sales.report_custom_saleorder2</field>
            <field name="binding_model_id" ref="sale.model_sale_order" />
            <field name="binding_type">report</field>
        </record>


        <!--  <menuitem id="menu_custom_saleorder_report"
            name="Custom Sales Order Report"
            parent="sale.menu_sale_order"
            action="action_report_custom_saleorder" />-->

    </data>
</odoo>