<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_custom_tab" model="ir.ui.view">
        <field name="name">product.template.custom.tab</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Pricing Breakdown">
                    <field name="product_breakdown_pricing_line_ids">
                        <list editable="bottom">
                            <field name="product_id" readonly="1" force_save="1" />
                            <field name="quantity" column_invisible="false" />
                            <field name="price" string="Cost" column_invisible="false" />
                            <field name="profit_margin" column_invisible="false" />
                            <field name="selling_price" column_invisible="false" />
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>